# Скопируйте в файл `.env` в корне репозитория (рядом с docker-compose.yml):
#   cp compose.env.example .env
#
# Порт, на котором приложение открывается в браузере.
STT_PORT=8080

# Адрес, на котором Docker публикует порт.
# 0.0.0.0 — доступен в сети сервера.
# 127.0.0.1 — только с самой машины (так делают, когда снаружи стоит Caddy или nginx).
STT_BIND=0.0.0.0

# Свой путь к кэшу Hugging Face (Whisper), если он лежит не в docker-bundled-models/huggingface.
# STT_HF_CACHE_HOST=/srv/stt/huggingface
