# --- Админ-панель (настройки системы) ---
# Перед деплоем замените пароль. Скрипт ./scripts/verify_deploy.sh не пройдёт, пока здесь admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Hugging Face (опционально) ---
# Пошаговая инструкция: docs/HF_TOKEN.md (в репозитории)
#
# HF_TOKEN нужен для:
#   • pyannote (разметка спикеров) при DIARIZATION_BACKEND=auto или pyannote
#   • GigaAM на файлах длиннее ~25 с — внутренняя сегментация речи (segmentation-3.0),
#     не заменяется Resemblyzer. Короткие файлы и весь Whisper работают без токена.
HF_TOKEN=

# --- Diarization ---
# auto = pyannote если есть HF_TOKEN, иначе Resemblyzer; при сбое pyannote → Resemblyzer
DIARIZATION_BACKEND=auto
# Только CLI/legacy. Веб: устройство в админке (CPU / GPU).
DIARIZATION_DEVICE=cpu

# --- Whisper (faster-whisper) ---
# WHISPER_MODEL / WHISPER_DEVICE — только для CLI / download_models.py.
# В веб-UI: модель и устройство задаются в админке (light/medium/heavy, cpu/gpu).
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- ffmpeg (опционально; иначе PATH или imageio-ffmpeg) ---
# FFMPEG_PATH=
# FFPROBE_PATH=

# --- Docker (задаёт compose; для локального dev не обязательно) ---
# DATA_DIR=/app/data
# STATIC_DIR=/app/static
# PORT=8080
# CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
