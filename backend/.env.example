# --- Админ-панель (настройки системы) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Hugging Face (опционально, для pyannote) ---
# Токен: https://huggingface.co/settings/tokens
# Лицензии: pyannote/speaker-diarization-3.1, pyannote/segmentation-3.0
HF_TOKEN=

# --- Diarization ---
# auto = pyannote если есть HF_TOKEN, иначе Resemblyzer; при сбое pyannote → Resemblyzer
DIARIZATION_BACKEND=auto
# cpu рекомендуется на Mac (MPS для pyannote часто нестабилен)
DIARIZATION_DEVICE=cpu

# --- Whisper (faster-whisper) ---
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- ffmpeg (опционально; иначе PATH или imageio-ffmpeg) ---
# FFMPEG_PATH=
# FFPROBE_PATH=
